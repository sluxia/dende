{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dende.local/schemas/acquisition-manifest-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "assetExternalKey", "runKey", "jurisdiction", "approvalHandoffPath", "acquisitionStatus", "relevanceAssessment", "files", "errors"],
  "properties": {
    "schemaVersion": { "const": "acquisition-manifest/v1" },
    "assetExternalKey": { "type": "string", "minLength": 1 },
    "runKey": { "type": "string", "minLength": 1 },
    "jurisdiction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["countryCode", "adminLevel1"],
      "properties": {
        "countryCode": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "adminLevel1": { "type": "string", "minLength": 1 },
        "adminLevel2": { "type": ["string", "null"] },
        "locality": { "type": ["string", "null"] }
      }
    },
    "approvalHandoffPath": { "type": "string", "minLength": 1 },
    "acquisitionStatus": { "enum": ["downloaded", "partial", "failed", "blocked"] },
    "relevanceAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "reason"],
      "properties": {
        "decision": { "enum": ["relevant", "ambiguous", "unrelated"] },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fileKey", "approvedUrl", "requestedUrl", "retrievalUrl", "retrievedAt", "status", "originalPath", "filename", "fileExtension", "declaredMediaType", "detectedMediaType", "formatFamily", "byteSize", "checksumSha256", "relationship", "sourceJurisdiction", "supportsTargetBoundary", "relationshipReason", "requiresVisualInspection", "visualInspection", "accessNotes", "errors"],
        "properties": {
          "fileKey": { "type": "string", "minLength": 1 },
          "approvedUrl": { "type": "string", "format": "uri" },
          "requestedUrl": { "type": "string", "format": "uri" },
          "retrievalUrl": { "type": ["string", "null"], "format": "uri" },
          "retrievedAt": { "type": ["string", "null"], "format": "date-time" },
          "status": { "enum": ["downloaded", "failed", "blocked"] },
          "originalPath": { "type": ["string", "null"] },
          "filename": { "type": ["string", "null"] },
          "fileExtension": { "type": ["string", "null"] },
          "declaredMediaType": { "type": ["string", "null"] },
          "detectedMediaType": { "type": ["string", "null"] },
          "formatFamily": { "enum": ["pdf", "image", "word", "spreadsheet", "delimited_text", "geospatial", "html", "archive", null] },
          "byteSize": { "type": ["integer", "null"], "minimum": 0 },
          "checksumSha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
          "relationship": { "enum": ["primary", "corroborating", "unrelated_example"] },
          "sourceJurisdiction": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["countryCode", "adminLevel1"],
            "properties": {
              "countryCode": { "type": "string", "pattern": "^[A-Z]{2}$" },
              "adminLevel1": { "type": "string", "minLength": 1 }
            }
          },
          "supportsTargetBoundary": { "type": "boolean" },
          "relationshipReason": { "type": "string", "minLength": 1 },
          "requiresVisualInspection": { "type": "boolean" },
          "visualInspection": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "inspector", "pagesOrItems"],
            "properties": {
              "status": { "enum": ["not_required", "required", "completed"] },
              "inspector": { "type": ["string", "null"] },
              "pagesOrItems": { "type": "array", "items": { "type": ["integer", "string"] } }
            }
          },
          "accessNotes": { "type": "array", "items": { "type": "string" } },
          "errors": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "errors": { "type": "array", "items": { "type": "string" } }
  }
}
