{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dende.local/schemas/research-query-log-v1.schema.json",
  "type": "array",
  "minItems": 21,
  "maxItems": 21,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["query_number", "query_group", "queries_run", "searched_at", "results", "negative_result_or_access_barrier"],
    "properties": {
      "query_number": { "type": "integer", "minimum": 1, "maximum": 21 },
      "query_group": { "type": "string", "minLength": 1 },
      "queries_run": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
      "searched_at": { "type": "string", "format": "date" },
      "negative_result_or_access_barrier": { "type": ["string", "null"] },
      "results": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["result_url", "direct_file_url", "title", "publisher", "date", "type", "authority_classification", "access_stage", "file_format", "licence", "named_assets", "instrument_references", "stated_areas", "coordinate_clues", "limitations"],
          "properties": {
            "result_url": { "type": "string", "format": "uri" },
            "direct_file_url": { "type": ["string", "null"], "format": "uri" },
            "title": { "type": "string", "minLength": 1 },
            "publisher": { "type": ["string", "null"] },
            "date": { "type": ["string", "null"] },
            "type": { "type": "string", "minLength": 1 },
            "authority_classification": { "type": "string", "minLength": 1 },
            "access_stage": { "type": "string", "minLength": 1 },
            "file_format": { "type": ["string", "null"] },
            "licence": { "type": ["string", "null"] },
            "named_assets": { "type": "array", "items": { "type": "string" } },
            "instrument_references": { "type": "array", "items": { "type": "string" } },
            "stated_areas": { "type": "array", "items": { "type": "string" } },
            "coordinate_clues": { "type": "array", "items": { "type": "string" } },
            "limitations": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    }
  }
}
