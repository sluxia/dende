{
  "name": "@sluxia/dende-server",
  "version": "0.1.0",
  "private": true,
  "description": "Dende Spatial Registry — PostGIS-backed overlap and zoning checks",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "migrate:up": "tsx scripts/migrate.ts up",
    "migrate:down": "tsx scripts/migrate.ts down",
    "db:up": "docker compose -f ../docker-compose.yml up -d db",
    "db:down": "docker compose -f ../docker-compose.yml down",
    "zones:import": "tsx scripts/import-zones.ts",
    "test": "npm run build && node --import tsx --test --test-concurrency=1 test/*.test.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^9.0.3",
    "@sluxia/dende-core": "file:..",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "node-pg-migrate": "^7.9.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.9",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
